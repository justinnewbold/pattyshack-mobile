{
  "expo": {
    "name": "Patty Shack",
    "slug": "pattyshack",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4CAF50"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pattyshack.operations"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4CAF50"
      },
      "package": "com.pattyshack.operations"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Patty Shack Checks"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "pattyshack"
  }
}
